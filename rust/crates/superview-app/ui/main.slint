// The application window, laid out as the Go one (`cmd/superview/gui_main.go`) and with its
// labels word for word. Nothing is computed here: the window shows properties it is given and
// reports clicks through callbacks, and `app.rs` owns every decision (phase 6 of DEC-43).
import { Palette, Button, CheckBox, ComboBox, LineEdit, ProgressIndicator, ScrollView, TextEdit } from "std-widgets.slint";

// The popup that is open: one at a time, `none` when the window is free.
export enum Popup {
    none,
    done,
    error,
    prerequisite,
    overwrite,
    quit,
    no-input,
    no-output,
    diagnostic,
    path-entry,
}

// What one line of the Diagnostic report is (parsed by `report.rs`, never by this file).
export enum ReportRowKind {
    blank,
    section,
    // A check or an encoder: an icon, then the text.
    check,
    // The detail under a check, indented and dimmer.
    value,
    // The overall verdict: "Status:", an icon, then the text.
    status,
    plain,
}

export struct DiagnosticRow {
    kind: ReportRowKind,
    // The icon's verdict for `check` and `status`; unused for the other kinds.
    ok: bool,
    text: string,
}

// A green disc with a tick, or a red one with a cross, drawn from shapes: no emoji and no font
// (the software renderer draws no colour emoji, which is why the report lost its marks).
component StatusIcon inherits Rectangle {
    in property <bool> ok;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: root.ok ? #2e9e4f : #d23a3a;
    accessible-role: image;
    accessible-label: root.ok ? "OK" : "Failed";
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: white;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.ok ? "M 4.5 8.5 L 7 11 L 11.5 5.5" : "M 5 5 L 11 11 M 11 5 L 5 11";
    }
}

// One line of the report. Built from fixed positions and not from layouts: a layout asks a
// wrapped Text for its height before the width is known, takes one line, and the list then
// ends a few lines short of the end of the report (measured). The Text's own
// `preferred-height`, at the width it is given, is right.
component ReportLine inherits Rectangle {
    in property <DiagnosticRow> line;
    // What "Status:" takes, with room for a wider monospace font on another system.
    private property <length> label-width: 54px;
    private property <bool> icon: root.line.kind == ReportRowKind.check
        || root.line.kind == ReportRowKind.status;
    private property <length> indent: root.line.kind == ReportRowKind.check ? 24px
        : root.line.kind == ReportRowKind.value ? 24px
        : root.line.kind == ReportRowKind.status ? root.label-width + 32px
        : 0px;
    height: root.line.kind == ReportRowKind.blank ? 8px : max(txt.preferred-height, 18px);
    if root.line.kind == ReportRowKind.status: Text {
        x: 0px;
        y: 0px;
        width: root.label-width;
        height: self.preferred-height;
        text: "Status:";
        font-family: "monospace";
        font-weight: 700;
    }
    if root.icon: StatusIcon {
        x: root.line.kind == ReportRowKind.status ? root.label-width + 8px : 0px;
        y: 1px;
        ok: root.line.ok;
    }
    txt := Text {
        x: root.indent;
        width: root.width - root.indent;
        height: self.preferred-height;
        text: root.line.kind == ReportRowKind.blank ? "" : root.line.text;
        font-family: "monospace";
        font-weight: root.line.kind == ReportRowKind.section
            || root.line.kind == ReportRowKind.status ? 700 : 400;
        color: root.line.kind == ReportRowKind.value ? #a8a8a8 : Palette.foreground;
        wrap: char-wrap;
    }
}

// A modal card. `if open` at the use site builds it only while it is shown; the full-window
// TouchArea takes every click, so nothing behind the card can be reached (a PopupWindow
// closes on an outside click by default, which is the opposite of a question the user must
// answer).
component Modal inherits Rectangle {
    in property <string> title;
    // False for a card that has a field of its own to focus.
    in property <bool> take-focus: true;
    // True for a card that holds a long text: it then takes the window's height (less a margin)
    // and its width up to `max-width`, and the child that stretches gets the room, so the
    // buttons below it stay inside the window however long the text is.
    in property <bool> fill: false;
    in property <length> card-max-width: 600px;

    background: #000000a0;
    TouchArea { }
    // Takes the keyboard focus, so keys do not reach the window behind the card.
    FocusScope {
        init => {
            if (root.take-focus) {
                self.focus();
            }
        }
    }
    Rectangle {
        width: min(parent.width - 40px, root.card-max-width);
        height: root.fill ? parent.height - 24px : card.preferred-height + 32px;
        background: Palette.background;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 6px;
        card := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: root.title; font-size: 16px; font-weight: 700; }
            @children
        }
    }
}

// The row of buttons that closes a modal, pushed to the right.
component ModalButtons inherits HorizontalLayout {
    alignment: end;
    spacing: 8px;
    @children
}

export component MainWindow inherits Window {
    // "Superview " + the build identity, set by `App::wire` (the Go window did the same).
    in property <string> window-title: "Superview";
    title: window-title;
    // The Go build's icon, read where it is: no second copy of the file (`build.rs` embeds it).
    icon: @image-url("../../../../cmd/superview/Icon.png");
    // Fixed size: minimum and maximum are the same, so the window cannot be resized.
    min-width: 980px;
    max-width: 980px;
    min-height: 470px;
    max-height: 470px;

    // Dark theme, whatever the desktop uses.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // What the window shows.
    in property <string> status: "Status: Ready";
    in property <string> results: "Results: no completed run yet";
    in property <string> hardware: "Hardware: waiting for input video";
    in property <string> input-name: "No file selected";
    in property <string> output-name: "No file selected";
    // 0 to 1.
    in property <float> progress: 0;
    // "Fast" or "Balanced".
    in-out property <string> quality: "Balanced";
    // The "source already stretched" box.
    in-out property <bool> squeeze: false;
    in property <[string]> encoder-options: [];
    in-out property <string> encoder-selected: "";

    // What the user can do now.
    in property <bool> start-enabled: false;
    in property <bool> cancel-enabled: false;
    in property <bool> open-enabled: true;
    in property <bool> output-enabled: true;
    in property <bool> quality-enabled: true;
    in property <bool> squeeze-enabled: true;
    in property <bool> encoder-enabled: true;
    in property <bool> diagnostic-enabled: true;

    // Which popup is open (one at a time) and what it says.
    in property <Popup> popup: Popup.none;
    in property <string> done-message;
    in property <string> error-message;
    in property <string> install-url;
    // False when there is nothing to retry: the dialog then only offers to close.
    in property <bool> prerequisite-retry: true;
    // The report as plain text (`[OK]` / `[FAIL]`), for the text view and for copying.
    in property <string> diagnostic-report;
    // The same report, line by line, for the list with drawn icons.
    in property <[DiagnosticRow]> diagnostic-rows: [];
    // Which view of the report is shown: the list (false) or the selectable text.
    in-out property <bool> diagnostic-as-text: false;
    // The text field that stands in for a file picker the system cannot open: whether it asks
    // for the output file (else the input), what is typed, and what is wrong with it.
    in property <bool> path-entry-output: false;
    in-out property <string> path-entry-text;
    in property <string> path-entry-error;

    // False while a popup is open: the controls behind it cannot be used, by mouse or key.
    private property <bool> free: root.popup == Popup.none;

    callback choose-input();
    callback choose-output();
    callback start();
    callback cancel();
    callback diagnostic();
    callback quit();
    callback quality-changed(string);
    callback squeeze-toggled(bool);
    callback encoder-changed(string);

    callback done-ok();
    callback error-ok();
    callback prerequisite-retry-clicked();
    callback prerequisite-close();
    callback open-install-link(string);
    callback overwrite-yes();
    callback overwrite-no();
    callback quit-yes();
    callback quit-no();
    callback no-input-ok();
    callback no-output-ok();
    callback diagnostic-close();
    callback path-entry-ok();
    callback path-entry-cancel();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        alignment: LayoutAlignment.start;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Superview";
                font-size: 28px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Convert 4:3 to 16:9 in one workflow";
                horizontal-alignment: center;
            }
        }

        // Centred: the layout packs the buttons together and centres the pack.
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Button {
                text: "Choose input file";
                enabled: root.free && root.open-enabled;
                clicked => { root.choose-input(); }
            }
            Button {
                text: "Choose output file";
                enabled: root.free && root.output-enabled;
                clicked => { root.choose-output(); }
            }
            Button {
                text: "Start transformation";
                enabled: root.free && root.start-enabled;
                clicked => { root.start(); }
            }
            Button {
                text: "Cancel";
                enabled: root.free && root.cancel-enabled;
                clicked => { root.cancel(); }
            }
            Button {
                text: "Diagnostic";
                enabled: root.free && root.diagnostic-enabled;
                clicked => { root.diagnostic(); }
            }
            Button {
                text: "Quit";
                enabled: root.free;
                clicked => { root.quit(); }
            }
        }

        GridLayout {
            spacing: 8px;
            Row {
                Text { text: "Input file"; vertical-alignment: center; }
                Text {
                    text: root.input-name;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Row {
                Text { text: "Output file"; vertical-alignment: center; }
                Text { text: root.output-name; vertical-alignment: center; overflow: elide; }
            }
            Row {
                Text { text: "Quality profile"; vertical-alignment: center; }
                ComboBox {
                    model: ["Fast", "Balanced"];
                    current-value <=> root.quality;
                    enabled: root.free && root.quality-enabled;
                    selected(value) => { root.quality-changed(value); }
                }
            }
            Row {
                Text { text: "Video codec"; vertical-alignment: center; }
                ComboBox {
                    model: root.encoder-options;
                    current-value <=> root.encoder-selected;
                    enabled: root.free && root.encoder-enabled;
                    selected(value) => { root.encoder-changed(value); }
                }
            }
            Row {
                Text { text: "Input format"; vertical-alignment: center; }
                CheckBox {
                    text: "Source already stretched to 16:9 (un-squeeze)";
                    checked <=> root.squeeze;
                    enabled: root.free && root.squeeze-enabled;
                    toggled => { root.squeeze-toggled(self.checked); }
                }
            }
        }

        Text { text: root.status; font-weight: 700; wrap: word-wrap; }
        Text { text: root.results; wrap: word-wrap; }
        Text { text: root.hardware; wrap: word-wrap; }

        HorizontalLayout {
            spacing: 8px;
            Text { text: "Progress"; vertical-alignment: center; }
            ProgressIndicator { progress: root.progress; }
        }
    }

    if root.popup == Popup.done: Modal {
        title: "Done";
        Text { text: root.done-message; wrap: char-wrap; }
        ModalButtons { Button { text: "OK"; primary: true; clicked => { root.done-ok(); } } }
    }

    if root.popup == Popup.error: Modal {
        title: "Error";
        Text { text: root.error-message; wrap: char-wrap; }
        ModalButtons { Button { text: "OK"; primary: true; clicked => { root.error-ok(); } } }
    }

    if root.popup == Popup.prerequisite: Modal {
        title: "Error";
        Text { text: "cannot find ffmpeg/ffprobe on your system"; }
        Text { text: "make sure to install it first:"; }
        // The link: a click is reported with the address, the host opens the browser.
        Text {
            text: root.install-url;
            color: #5aa9ff;
            wrap: char-wrap;
            TouchArea {
                accessible-role: button;
                accessible-label: "Open " + root.install-url;
                accessible-action-default => { root.open-install-link(root.install-url); }
                mouse-cursor: pointer;
                clicked => { root.open-install-link(root.install-url); }
            }
        }
        if root.prerequisite-retry: Text { text: "Already installed it? Use Retry."; }
        ModalButtons {
            if root.prerequisite-retry: Button {
                text: "Retry";
                primary: true;
                clicked => { root.prerequisite-retry-clicked(); }
            }
            Button {
                text: root.prerequisite-retry ? "Close" : "OK";
                clicked => { root.prerequisite-close(); }
            }
        }
    }

    if root.popup == Popup.overwrite: Modal {
        title: "Overwrite output file";
        Text { text: "The selected output file already exists. Overwrite it?"; wrap: word-wrap; }
        ModalButtons {
            Button { text: "Yes"; primary: true; clicked => { root.overwrite-yes(); } }
            Button { text: "No"; clicked => { root.overwrite-no(); } }
        }
    }

    if root.popup == Popup.quit: Modal {
        title: "Cancel and quit";
        Text {
            text: "An encoding is in progress. Do you want to cancel and quit?";
            wrap: word-wrap;
        }
        ModalButtons {
            Button { text: "Yes"; primary: true; clicked => { root.quit-yes(); } }
            Button { text: "No"; clicked => { root.quit-no(); } }
        }
    }

    if root.popup == Popup.no-input: Modal {
        title: "No input";
        Text { text: "Please open an input video first."; wrap: word-wrap; }
        ModalButtons { Button { text: "OK"; primary: true; clicked => { root.no-input-ok(); } } }
    }

    if root.popup == Popup.no-output: Modal {
        title: "No output";
        Text { text: "Please choose an output file first."; wrap: word-wrap; }
        ModalButtons { Button { text: "OK"; primary: true; clicked => { root.no-output-ok(); } } }
    }

    if root.popup == Popup.diagnostic: Modal {
        title: "System diagnostic";
        fill: true;
        card-max-width: 900px;
        // The list has drawn icons but no text selection (Slint has no clipboard API); the text
        // view is a read-only TextEdit, not a disabled one, so Ctrl+C copies the report into a
        // bug report. Both have visible scrollbars and a wheel: a report too long for the card
        // can be read to its end.
        if !root.diagnostic-as-text: Rectangle {
            vertical-stretch: 1;
            min-height: 120px;
            background: Palette.alternate-background;
            border-width: 1px;
            border-color: Palette.border;
            ScrollView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                vertical-scrollbar-policy: always-on;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    width: parent.visible-width;
                    padding: 6px;
                    spacing: 3px;
                    for entry in root.diagnostic-rows: ReportLine { line: entry; }
                }
            }
        }
        if root.diagnostic-as-text: TextEdit {
            read-only: true;
            text: root.diagnostic-report;
            font-family: "monospace";
            wrap: char-wrap;
            vertical-stretch: 1;
            min-height: 120px;
        }
        ModalButtons {
            Button {
                text: root.diagnostic-as-text ? "Show as list" : "Show as text";
                clicked => { root.diagnostic-as-text = !root.diagnostic-as-text; }
            }
            Button { text: "Close"; primary: true; clicked => { root.diagnostic-close(); } }
        }
    }

    if root.popup == Popup.path-entry: Modal {
        title: root.path-entry-output ? "Save output video" : "Select input video";
        take-focus: false;
        Text {
            text: "No file picker could be opened. Type the full path of the file:";
            wrap: word-wrap;
        }
        LineEdit {
            width: 520px;
            text <=> root.path-entry-text;
            accessible-label: "Path";
            init => { self.focus(); }
            accepted => { root.path-entry-ok(); }
        }
        if root.path-entry-error != "": Text {
            text: root.path-entry-error;
            color: #ff7070;
            wrap: word-wrap;
        }
        ModalButtons {
            Button { text: "OK"; primary: true; clicked => { root.path-entry-ok(); } }
            Button { text: "Cancel"; clicked => { root.path-entry-cancel(); } }
        }
    }
}
