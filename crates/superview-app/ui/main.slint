// The application window, laid out as v0.2.9's window, with its labels word for word. Nothing is computed here: the window shows
// properties it is given and reports clicks through callbacks, and `app.rs` owns every decision (DEC-43).
import { Palette, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppButton, BarState, Card, Pill, ProgressBar, SegmentedControl, Switch } from "components.slint";

// The colours, for the Rust side to read in tests.
export { BarState, Theme }

// The popup that is open: one at a time, `none` when the window is free.
export enum Popup {
    none,
    done,
    error,
    prerequisite,
    overwrite,
    quit,
    no-input,
    no-output,
    diagnostic,
    path-entry,
}

// What one line of the Diagnostic report is (parsed by `report.rs`, never by this file).
export enum ReportRowKind {
    blank,
    section,
    // A check or an encoder: an icon, then the text.
    check,
    // The detail under a check, indented and dimmer.
    value,
    // The overall verdict: "Status:", an icon, then the text.
    status,
    plain,
}

export struct DiagnosticRow {
    kind: ReportRowKind,
    // The icon's verdict for `check` and `status`; unused for the other kinds.
    ok: bool,
    text: string,
}

// A green disc with a tick, or a red one with a cross, drawn from shapes: no emoji and no font
// (the software renderer draws no colour emoji, which is why the report lost its marks).
component StatusIcon inherits Rectangle {
    in property <bool> ok;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: root.ok ? #2e9e4f : #d23a3a;
    accessible-role: image;
    accessible-label: root.ok ? "OK" : "Failed";
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: white;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.ok ? "M 4.5 8.5 L 7 11 L 11.5 5.5" : "M 5 5 L 11 11 M 11 5 L 5 11";
    }
}

// One line of the report. Built from fixed positions and not from layouts: a layout asks a
// wrapped Text for its height before the width is known, takes one line, and the list then
// ends a few lines short of the end of the report (measured). The Text's own
// `preferred-height`, at the width it is given, is right.
component ReportLine inherits Rectangle {
    in property <DiagnosticRow> line;
    // What "Status:" takes, with room for a wider monospace font on another system.
    private property <length> label-width: 54px;
    private property <bool> icon: root.line.kind == ReportRowKind.check
        || root.line.kind == ReportRowKind.status;
    private property <length> indent: root.line.kind == ReportRowKind.check ? 24px
        : root.line.kind == ReportRowKind.value ? 24px
        : root.line.kind == ReportRowKind.status ? root.label-width + 32px
        : 0px;
    height: root.line.kind == ReportRowKind.blank ? 8px : max(txt.preferred-height, 18px);
    if root.line.kind == ReportRowKind.status: Text {
        x: 0px;
        y: 0px;
        width: root.label-width;
        height: self.preferred-height;
        text: "Status:";
        font-family: "monospace";
        font-weight: 700;
    }
    if root.icon: StatusIcon {
        x: root.line.kind == ReportRowKind.status ? root.label-width + 8px : 0px;
        y: 1px;
        ok: root.line.ok;
    }
    txt := Text {
        x: root.indent;
        width: root.width - root.indent;
        height: self.preferred-height;
        text: root.line.kind == ReportRowKind.blank ? "" : root.line.text;
        font-family: "monospace";
        font-weight: root.line.kind == ReportRowKind.section
            || root.line.kind == ReportRowKind.status ? 700 : 400;
        color: root.line.kind == ReportRowKind.value ? Theme.text-muted : Theme.text;
        wrap: char-wrap;
    }
}

// A modal card. `if open` at the use site builds it only while it is shown; the full-window
// TouchArea takes every click, so nothing behind the card can be reached (a PopupWindow
// closes on an outside click by default, which is the opposite of a question the user must
// answer).
component Modal inherits Rectangle {
    in property <string> title;
    // False for a card that has a field of its own to focus.
    in property <bool> take-focus: true;
    // True for a card that holds a long text: it then takes the window's height (less a margin)
    // and its width up to `max-width`, and the child that stretches gets the room, so the
    // buttons below it stay inside the window however long the text is.
    in property <bool> fill: false;
    in property <length> card-max-width: 600px;
    // Enter and Escape. A card leaves the one it should not answer unwired: a destructive
    // question is never confirmed by a stray Enter.
    callback confirmed();
    callback dismissed();

    background: Theme.scrim;
    TouchArea { }
    // Takes the keyboard focus, so keys do not reach the window behind the card. The card is
    // its child: a key that a button or a field refuses rises to it.
    FocusScope {
        init => {
            if (root.take-focus) {
                self.focus();
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            if (event.text == Key.Return) {
                root.confirmed();
                return accept;
            }
            reject
        }
        Rectangle {
            width: min(parent.width - 40px, root.card-max-width);
            height: root.fill ? parent.height - 24px : card.preferred-height + 32px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 6px;
            card := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: root.title; font-size: 16px; font-weight: 700; }
                @children
            }
        }
    }
}

// The row of buttons that closes a modal, pushed to the right.
component ModalButtons inherits HorizontalLayout {
    alignment: end;
    spacing: 8px;
    @children
}

export component MainWindow inherits Window {
    // "Superview " + the build identity, set by `App::wire`.
    in property <string> window-title: "Superview";
    title: window-title;
    // The window icon, next to this file (`build.rs` embeds it in the binary).
    icon: @image-url("Icon.png");
    // Fixed size (DEC-61): minimum and maximum are the same, so the window cannot be resized.
    min-width: 1000px;
    max-width: 1000px;
    min-height: 570px;
    max-height: 570px;

    background: Theme.panel;
    // The theme the user chose (DEC-57), not the desktop's: the global and Slint's own widgets follow it.
    init => { root.apply-theme(); }
    changed theme => { root.apply-theme(); }
    // What Slint's own widgets draw with, for the tests.
    out property <bool> scheme-dark: Palette.color-scheme == ColorScheme.dark;
    function apply-theme() {
        Theme.name = root.theme;
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    // What the window shows.
    in property <string> status: "Status: Ready";
    in property <string> results: "Results: no completed run yet";
    in property <string> hardware: "Hardware: waiting for input video";
    in property <string> input-name: "No file selected";
    // "h264 · 1440×1080 · 2m15s", empty before a file is chosen.
    in property <string> input-specs;
    // One frame of the input, once it is decoded.
    in property <image> thumbnail;
    in property <bool> has-thumbnail: false;
    in property <string> output-name: "No file selected";
    // 0 to 1.
    in property <float> progress: 0;
    in property <BarState> bar-state: BarState.idle;
    // The colour of the bar's fill, for the tests.
    out property <color> bar-fill: bar.fill;
    // The profiles the menu offers: `prefs::QUALITY_PROFILES`, the list a saved choice is
    // validated against.
    in property <[string]> quality-profiles;
    // "Fast" or "Balanced".
    in-out property <string> quality: "Balanced";
    // The "source already stretched" box.
    in-out property <bool> squeeze: false;
    in property <[string]> encoder-options: [];
    in-out property <string> encoder-selected: "";
    // The Theme menu: `prefs::THEMES`, and "Light" or "Dark".
    in property <[string]> theme-options;
    in-out property <string> theme: "Dark";

    // What the user can do now.
    in property <bool> start-enabled: false;
    in property <bool> cancel-enabled: false;
    in property <bool> open-enabled: true;
    in property <bool> output-enabled: true;
    in property <bool> quality-enabled: true;
    in property <bool> squeeze-enabled: true;
    in property <bool> encoder-enabled: true;
    in property <bool> diagnostic-enabled: true;

    // Which popup is open (one at a time) and what it says.
    in property <Popup> popup: Popup.none;
    in property <string> done-message;
    in property <string> error-message;
    in property <string> install-url;
    // False when there is nothing to retry: the dialog then only offers to close.
    in property <bool> prerequisite-retry: true;
    // The report as plain text (`[OK]` / `[FAIL]`), for the text view and for copying.
    in property <string> diagnostic-report;
    // The same report, line by line, for the list with drawn icons.
    in property <[DiagnosticRow]> diagnostic-rows: [];
    // Which view of the report is shown: the list (false) or the selectable text.
    in-out property <bool> diagnostic-as-text: false;
    // The text field that stands in for a file picker the system cannot open: whether it asks
    // for the output file (else the input), what is typed, and what is wrong with it.
    in property <bool> path-entry-output: false;
    in-out property <string> path-entry-text;
    in property <string> path-entry-error;

    // What the state pill says.
    out property <string> state-label: root.bar-state == BarState.running ? "Converting"
        : root.bar-state == BarState.done ? "Completed"
        : root.bar-state == BarState.stopped ? "Stopped"
        : "Ready";

    // False while a popup is open: the controls behind it cannot be used, by mouse or key.
    private property <bool> free: root.popup == Popup.none;

    callback choose-input();
    callback choose-output();
    callback start();
    callback cancel();
    callback diagnostic();
    callback quit();
    callback quality-changed(string);
    callback squeeze-toggled(bool);
    callback encoder-changed(string);
    callback theme-changed(string);

    callback done-ok();
    callback error-ok();
    callback prerequisite-retry-clicked();
    callback prerequisite-close();
    callback open-install-link(string);
    callback overwrite-yes();
    callback overwrite-no();
    callback quit-yes();
    callback quit-no();
    callback no-input-ok();
    callback no-output-ok();
    callback diagnostic-close();
    callback path-entry-ok();
    callback path-entry-cancel();

    VerticalLayout {
        // The header: what the program does, and the Theme menu. The name is in the title bar.
        HorizontalLayout {
            padding: 12px;
            padding-bottom: 0px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;
            Text {
                text: "Convert 4:3 to 16:9 in one workflow";
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "Theme"; vertical-alignment: center; }
            ComboBox {
                width: 100px;
                accessible-label: "Theme";
                model: root.theme-options;
                current-value <=> root.theme;
                enabled: root.free;
                selected(value) => { root.theme-changed(value); }
            }
        }

        HorizontalLayout {
            // The file: the input in a card, then the output in a field.
            VerticalLayout {
                width: 600px;
                padding: 14px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;
                alignment: LayoutAlignment.start;

                Text { text: "Input file"; color: Theme.text-muted; font-weight: 600; font-size: 12px; }
                Rectangle {
                    height: 96px;
                    border-radius: 12px;
                    border-width: 1.5px;
                    border-color: Theme.accent;
                    background: Theme.accent.with-alpha(0.08);
                    // The video's picture: 96x72 (4:3), which fills it once decoded.
                    Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 96px;
                        height: 72px;
                        border-radius: 8px;
                        background: Theme.surface;
                        clip: true;
                        if root.has-thumbnail: Image {
                            source: root.thumbnail;
                            width: parent.width;
                            height: parent.height;
                            accessible-role: none;
                        }
                    }
                    VerticalLayout {
                        x: 122px;
                        y: 12px;
                        width: parent.width - 122px - 190px;
                        spacing: 4px;
                        alignment: LayoutAlignment.start;
                        Text {
                            text: root.input-name;
                            font-size: 15px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text { text: root.input-specs; color: Theme.text-muted; overflow: elide; }
                    }
                    AppButton {
                        x: parent.width - self.width - 12px;
                        y: (parent.height - self.height) / 2;
                        width: 160px;
                        height: 34px;
                        text: "Choose input file";
                        enabled: root.free && root.open-enabled;
                        clicked => { root.choose-input(); }
                    }
                }

                Text { text: "Output file"; color: Theme.text-muted; font-weight: 600; font-size: 12px; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.background;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: root.output-name;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    AppButton {
                        text: "Choose output file";
                        enabled: root.free && root.output-enabled;
                        clicked => { root.choose-output(); }
                    }
                }
            }

            // The settings and the conversion, on a darker ground with a line to its left.
            Rectangle {
                width: 400px;
                background: Theme.background;
                Rectangle {
                    x: 0px;
                    width: 1px;
                    background: Theme.border;
                }
                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    padding: 14px;
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 12px;

                    // Each field: its label 6 px above it; the fields 12 px apart (the mockup's).
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Quality profile"; color: Theme.text-muted; font-weight: 600; font-size: 12px; }
                        SegmentedControl {
                            model: root.quality-profiles;
                            current <=> root.quality;
                            enabled: root.free && root.quality-enabled;
                            selected(value) => { root.quality-changed(value); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Video codec"; color: Theme.text-muted; font-weight: 600; font-size: 12px; }
                        ComboBox {
                            model: root.encoder-options;
                            current-value <=> root.encoder-selected;
                            enabled: root.free && root.encoder-enabled;
                            selected(value) => { root.encoder-changed(value); }
                        }
                    }
                    // No label of its own, as in the mockup: the switch carries its text.
                    Switch {
                        text: "Source already stretched to 16:9 (un-squeeze)";
                        checked <=> root.squeeze;
                        enabled: root.free && root.squeeze-enabled;
                        toggled(on) => { root.squeeze-toggled(on); }
                    }
                    // At most two lines (a refusal from the probe can be long; the Diagnostic has it whole).
                    Text {
                        text: root.hardware;
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                        overflow: elide;
                        // Explicit: a wrapped text's own minimum height would win over a maximum.
                        height: min(self.preferred-height, 32px);
                    }

                    Rectangle { vertical-stretch: 1; }

                    // The conversion: the state, the figure and the bar, what is going on and what
                    // it gave, then Start and Cancel.
                    Card {
                        height: conversion.preferred-height;
                        conversion := VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            alignment: LayoutAlignment.start;

                            Pill { text: root.state-label; tone: bar.fill; }
                            Text {
                                text: "\{Math.round(root.progress * 100)} %";
                                font-size: 44px;
                                font-weight: 800;
                                // The mockup's line height of 1: Slint's own would add a third.
                                height: 44px;
                                vertical-alignment: center;
                            }
                            bar := ProgressBar { progress: root.progress; state: root.bar-state; }
                            // One line: the starting message is the longest, and the Diagnostic and the log keep it whole.
                            Text { text: root.status; font-weight: 700; overflow: elide; }
                            Text {
                                text: root.results;
                                color: Theme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                                overflow: elide;
                                // At most two lines, like the hardware line.
                                height: min(self.preferred-height, 32px);
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                AppButton {
                                    horizontal-stretch: 1;
                                    text: "Start transformation";
                                    primary: true;
                                    enabled: root.free && root.start-enabled;
                                    clicked => { root.start(); }
                                }
                                AppButton {
                                    text: "Cancel";
                                    enabled: root.free && root.cancel-enabled;
                                    clicked => { root.cancel(); }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            text: "Diagnostic";
                            enabled: root.free && root.diagnostic-enabled;
                            clicked => { root.diagnostic(); }
                        }
                        AppButton {
                            text: "Quit";
                            enabled: root.free;
                            clicked => { root.quit(); }
                        }
                    }
                }
            }
        }
    }

    if root.popup == Popup.done: Modal {
        title: "Done";
        confirmed => { root.done-ok(); }
        dismissed => { root.done-ok(); }
        Text { text: root.done-message; wrap: char-wrap; }
        ModalButtons { AppButton { text: "OK"; primary: true; clicked => { root.done-ok(); } } }
    }

    if root.popup == Popup.error: Modal {
        title: "Error";
        confirmed => { root.error-ok(); }
        dismissed => { root.error-ok(); }
        ScrollView {
            max-height: 300px;
            preferred-height: message.preferred-height;
            content-height: message.preferred-height;
            vertical-scrollbar-policy: as-needed;
            horizontal-scrollbar-policy: always-off;
            message := Text {
                width: parent.visible-width;
                text: root.error-message;
                wrap: char-wrap;
            }
        }
        ModalButtons { AppButton { text: "OK"; primary: true; clicked => { root.error-ok(); } } }
    }

    if root.popup == Popup.prerequisite: Modal {
        title: "Error";
        confirmed => {
            if (root.prerequisite-retry) {
                root.prerequisite-retry-clicked();
            } else {
                root.prerequisite-close();
            }
        }
        dismissed => { root.prerequisite-close(); }
        Text { text: "cannot find ffmpeg/ffprobe on your system"; }
        Text { text: "make sure to install it first:"; }
        // The link: a click is reported with the address, the host opens the browser.
        Text {
            text: root.install-url;
            color: Theme.accent;
            wrap: char-wrap;
            TouchArea {
                accessible-role: button;
                accessible-label: "Open " + root.install-url;
                accessible-action-default => { root.open-install-link(root.install-url); }
                mouse-cursor: pointer;
                clicked => { root.open-install-link(root.install-url); }
            }
        }
        if root.prerequisite-retry: Text { text: "Already installed it? Use Retry."; }
        ModalButtons {
            if root.prerequisite-retry: AppButton {
                text: "Retry";
                primary: true;
                clicked => { root.prerequisite-retry-clicked(); }
            }
            AppButton {
                text: root.prerequisite-retry ? "Close" : "OK";
                clicked => { root.prerequisite-close(); }
            }
        }
    }

    if root.popup == Popup.overwrite: Modal {
        title: "Overwrite output file";
        dismissed => { root.overwrite-no(); }
        Text { text: "The selected output file already exists. Overwrite it?"; wrap: word-wrap; }
        ModalButtons {
            AppButton { text: "Yes"; primary: true; clicked => { root.overwrite-yes(); } }
            AppButton { text: "No"; clicked => { root.overwrite-no(); } }
        }
    }

    if root.popup == Popup.quit: Modal {
        title: "Cancel and quit";
        dismissed => { root.quit-no(); }
        Text {
            text: "An encoding is in progress. Do you want to cancel and quit?";
            wrap: word-wrap;
        }
        ModalButtons {
            AppButton { text: "Yes"; primary: true; clicked => { root.quit-yes(); } }
            AppButton { text: "No"; clicked => { root.quit-no(); } }
        }
    }

    if root.popup == Popup.no-input: Modal {
        title: "No input";
        confirmed => { root.no-input-ok(); }
        dismissed => { root.no-input-ok(); }
        Text { text: "Please open an input video first."; wrap: word-wrap; }
        ModalButtons { AppButton { text: "OK"; primary: true; clicked => { root.no-input-ok(); } } }
    }

    if root.popup == Popup.no-output: Modal {
        title: "No output";
        confirmed => { root.no-output-ok(); }
        dismissed => { root.no-output-ok(); }
        Text { text: "Please choose an output file first."; wrap: word-wrap; }
        ModalButtons { AppButton { text: "OK"; primary: true; clicked => { root.no-output-ok(); } } }
    }

    if root.popup == Popup.diagnostic: Modal {
        title: "System diagnostic";
        confirmed => { root.diagnostic-close(); }
        dismissed => { root.diagnostic-close(); }
        fill: true;
        card-max-width: 900px;
        // The list has drawn icons but no text selection (Slint has no clipboard API); the text
        // view is a read-only TextEdit, not a disabled one, so Ctrl+C copies the report into a
        // bug report. Both have visible scrollbars and a wheel: a report too long for the card
        // can be read to its end.
        if !root.diagnostic-as-text: Rectangle {
            vertical-stretch: 1;
            min-height: 120px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            ScrollView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                vertical-scrollbar-policy: always-on;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    width: parent.visible-width;
                    padding: 6px;
                    spacing: 3px;
                    for entry in root.diagnostic-rows: ReportLine { line: entry; }
                }
            }
        }
        if root.diagnostic-as-text: TextEdit {
            read-only: true;
            text: root.diagnostic-report;
            font-family: "monospace";
            wrap: char-wrap;
            vertical-stretch: 1;
            min-height: 120px;
        }
        ModalButtons {
            AppButton {
                text: root.diagnostic-as-text ? "Show as list" : "Show as text";
                clicked => { root.diagnostic-as-text = !root.diagnostic-as-text; }
            }
            AppButton { text: "Close"; primary: true; clicked => { root.diagnostic-close(); } }
        }
    }

    if root.popup == Popup.path-entry: Modal {
        title: root.path-entry-output ? "Save output video" : "Select input video";
        take-focus: false;
        dismissed => { root.path-entry-cancel(); }
        Text {
            text: "No file picker could be opened. Type the full path of the file:";
            wrap: word-wrap;
        }
        LineEdit {
            width: 520px;
            text <=> root.path-entry-text;
            accessible-label: "Path";
            init => { self.focus(); }
            accepted => { root.path-entry-ok(); }
        }
        if root.path-entry-error != "": Text {
            text: root.path-entry-error;
            color: Theme.error;
            wrap: word-wrap;
        }
        ModalButtons {
            AppButton { text: "OK"; primary: true; clicked => { root.path-entry-ok(); } }
            AppButton { text: "Cancel"; clicked => { root.path-entry-cancel(); } }
        }
    }
}
