// The widgets that carry the accent. Each keeps the accessible role and label of the Slint widget it
// replaces, because the window tests find their targets by label and role.
import { Theme } from "theme.slint";

// A button: `primary` fills it with the accent. Enter and Space press it when it has the focus.
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: label.preferred-width + 28px;
    min-height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.border;
    background: !root.enabled ? Theme.surface
        : root.primary ? (touch.pressed ? Theme.accent.darker(0.2) : touch.has-hover ? (Theme.dark ? Theme.accent.brighter(0.15) : Theme.accent.darker(0.1)) : Theme.accent)
        : (touch.pressed ? Theme.border : touch.has-hover ? Theme.surface : Theme.panel);
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    // Like Slint's Button, the accessible action does not look at `enabled`: the window tests press
    // buttons behind a popup that way. The mouse and the keys do look at it (the TouchArea and the
    // FocusScope below are disabled with the button).
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    // Zero width, like Slint's own Button: a FocusScope that covered the button would take the
    // press to get the focus and the TouchArea below would never see the first click.
    key := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    // The focus ring: only while the keyboard has the focus here.
    Rectangle {
        visible: key.has-focus;
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.accent;
    }
    // Not announced on its own: the button already carries the same label.
    label := Text {
        accessible-role: none;
        text: root.text;
        color: root.primary ? Theme.on-accent : Theme.text;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A raised panel: the background of a group of controls.
export component Card inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;
}

// What the bar's colour says (`state::BarState`, DEC-58).
export enum BarState {
    idle,
    running,
    done,
    stopped,
}

// The progress bar: a track and a fill that eases towards the figure it is given. The ease runs only
// while a conversion goes and has begun: a fill that jumps back to nothing for a new start, or lands
// on a finished one, is not animated.
export component ProgressBar inherits Rectangle {
    // 0 to 1.
    in property <float> progress;
    in property <BarState> state: BarState.idle;
    // The fill's colour, read by the window tests.
    out property <color> fill: root.state == BarState.running ? Theme.running
        : root.state == BarState.done ? Theme.done
        : root.state == BarState.stopped ? Theme.text-muted
        : Theme.accent;

    height: 10px;
    border-radius: 5px;
    background: Theme.surface;
    accessible-role: progress-indicator;
    accessible-value: root.progress;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    clip: true;
    Rectangle {
        x: 0px;
        width: parent.width * clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: root.border-radius;
        background: root.fill;
        animate width {
            duration: root.state == BarState.running && root.progress > 0 ? 400ms : 0ms;
            easing: ease-out;
        }
    }
}

// A row of exclusive choices, the chosen one filled with the accent. Each segment is a radio button
// for the window tests and for assistive technology; Enter and Space choose the one that has the
// focus. `current` is two-way: the user's pick writes it and the host's later writes show.
export component SegmentedControl inherits Rectangle {
    in property <[string]> model;
    in-out property <string> current;
    in property <bool> enabled: true;
    callback selected(string);

    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for item in root.model: Rectangle {
            border-radius: 6px;
            background: item == root.current ? Theme.accent : touch.has-hover && root.enabled ? Theme.border : transparent;
            accessible-role: radio-button;
            accessible-label: item;
            accessible-checkable: true;
            accessible-checked: item == root.current;
            accessible-enabled: root.enabled;
            accessible-action-default => {
                if (root.enabled) {
                    root.pick(item);
                }
            }
            touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                clicked => { root.pick(item); }
            }
            // Tab reaches each segment: the ring shows where the keyboard is.
            keys := FocusScope {
                x: 0;
                width: 0;
                enabled: root.enabled;
                key-pressed(event) => {
                    if (root.enabled && (event.text == Key.Return || event.text == " ")) {
                        root.pick(item);
                        return accept;
                    }
                    reject
                }
            }
            Rectangle {
                visible: keys.has-focus;
                border-radius: 6px;
                border-width: 2px;
                border-color: Theme.on-accent;
            }
            Text {
                accessible-role: none;
                text: item;
                font-weight: 600;
                color: item == root.current ? Theme.on-accent : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    function pick(item: string) {
        if (item == root.current) {
            return;
        }
        root.current = item;
        root.selected(item);
    }
}

// An on/off switch with its label beside it. A click or Space toggles it; `checked` is two-way.
export component Switch inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    min-height: 28px;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.flip();
        }
    }

    function flip() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.flip(); }
    }
    // Tab reaches the switch: the ring around the track shows where the keyboard is.
    keys := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == " ")) {
                root.flip();
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 40px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 11px;
            background: root.checked ? Theme.accent : Theme.border;
            border-width: keys.has-focus ? 2px : 0px;
            border-color: Theme.text;
            Rectangle {
                width: 16px;
                height: 16px;
                y: 3px;
                x: root.checked ? 21px : 3px;
                border-radius: 8px;
                background: root.checked ? Theme.on-accent : Theme.text-muted;
                animate x { duration: 120ms; easing: ease-out; }
            }
        }
        Text {
            accessible-role: none;
            text: root.text;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}
