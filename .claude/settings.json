{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(SUPERVIEW_REQUIRE_FFMPEG=1 cargo test *)",
      "Bash(ffmpeg -version)",
      "Bash(ffprobe *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh run watch *)",
      "Bash(gh api repos/Canaill51/superview/*)",
      "Bash(scripts/check.sh*)",
      "Bash(bash scripts/check.sh*)",
      "Bash(bash scripts/checks/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Read(~/docs-officielles/**)",
      "Read(~/.claude/pieges/**)"
    ],
    "ask": [
      "Bash(gh workflow run release.yml *)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api * -f*)",
      "Bash(gh api * -F*)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(ffprobe * -o*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git tag *)",
      "Bash(gh release create *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/apres-modif.sh",
            "timeout": 120,
            "statusMessage": "Vérification rapide…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/garde-fou.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/avant-fin.sh",
            "timeout": 600,
            "statusMessage": "Tests complets…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/debut-session.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
